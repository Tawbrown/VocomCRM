# Copy this file to .env.local and fill in real values. .env.local is gitignored —
# never commit real secrets.

# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Instantly (Settings > API in Instantly)
INSTANTLY_API_KEY=

# Any random 32+ char string — must match what's configured in Vercel's Cron settings,
# which Vercel sends automatically as "Authorization: Bearer <CRON_SECRET>" once this
# env var is set on the project.
CRON_SECRET=

# Framer webhook signing secret — set the same value in Framer's form webhook "Secret"
# field (min 32 characters, Framer's own requirement).
FRAMER_WEBHOOK_SECRET=

# Google service account JSON key, base64-encoded (`base64 -i key.json` on Mac/Linux).
# Create in Google Cloud Console, then add its email as a user in both Search Console
# and GA4 (Property Access Management) — no OAuth login flow needed.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Search Console property — either a full URL like "https://vocom.ai/" (URL-prefix
# property) or "sc-domain:vocom.ai" (domain property) — check which type it is in
# Search Console's property dropdown.
GSC_SITE_URL=

# GA4 property ID — the numeric ID in Analytics under Admin > Property Settings
# (not the "G-XXXX" measurement ID).
GA4_PROPERTY_ID=

# Gemini API key for the monthly SEO report — free tier, no credit card needed
# (aistudio.google.com/apikey).
GEMINI_API_KEY=
