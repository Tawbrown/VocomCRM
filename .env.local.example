# Copy this file to .env.local and fill in real values. .env.local is gitignored —
# never commit real secrets.

# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Instantly (Settings > API in Instantly)
INSTANTLY_API_KEY=

# Any random 32+ char string — must match what's configured in Vercel's Cron settings,
# which Vercel sends automatically as "Authorization: Bearer <CRON_SECRET>" once this
# env var is set on the project.
CRON_SECRET=

# Framer webhook signing secret — set the same value in Framer's form webhook "Secret"
# field (min 32 characters, Framer's own requirement).
FRAMER_WEBHOOK_SECRET=
